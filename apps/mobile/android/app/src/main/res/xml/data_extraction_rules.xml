<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never move app data to the cloud or a new device. Keystore-encrypted tokens can't be decrypted
     on another device, and a restored-but-undecryptable store would sign the user out with a confusing error. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
