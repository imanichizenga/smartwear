# ---- The ONLY environment variables the backend needs. Everything else lives in the database (Admin → Settings).
DATABASE_URL=postgresql://smartwear:smartwear@localhost:5432/smartwear
REDIS_URL=redis://localhost:6379
# 32 bytes, base64. Generate: python3 -c "import os,base64;print('k1.'+base64.b64encode(os.urandom(32)).decode())"
# Format is <keyId>.<base64Key>; multiple keys separated by commas enable rotation (first = current).
MASTER_ENCRYPTION_KEY=k1.REPLACE_ME_WITH_32_BYTES_BASE64
# Public URL the admin browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL the mobile dev build uses to reach the API (LAN IP when running on a device)
EXPO_PUBLIC_API_URL=http://localhost:4000
